{
  "name": "@nobeta-work/tobe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A persistent personal companion agent built on Pi.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "agent",
    "companion-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Nobeta-Work/tobe.git"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./awareness/index.ts",
      "./memory/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test awareness/tests/*.test.ts awareness/adapters/*/*.test.ts",
    "check": "npm run typecheck && npm test",
    "start": "node --import tsx web/index.ts",
    "start:pi": "pi",
    "update": "git pull --ff-only && npm install"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@wechatbot/wechatbot": "^2.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
